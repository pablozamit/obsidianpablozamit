{
  "preset": "jest-expo",
  "setupFilesAfterEnv": ["<rootDir>/jest.setup.js"],
  "transformIgnorePatterns": [
    "node_modules/(?!(@react-native|react-native|expo|@expo|@expo/vector-icons|react-native-safe-area-context|react-native-screens|firebase|zustand|zod)/)"
  ],
  "testMatch": ["**/*.test.[jt]s?(x)", "**/?(*.)+(spec|test).[jt]s?(x)"],
  "testPathIgnorePatterns": ["<rootDir>/node_modules/"],
  "collectCoverageFrom": [
    "src/**/*.{js,jsx,ts,tsx}",
    "!src/**/*.d.ts",
    "!src/types/**",
    "!src/navigation/**",
    "!src/constants/**",
    "!src/**/index.ts"
  ],
  "coverageThreshold": {
    "global": {
      "branches": 30,
      "functions": 40,
      "lines": 45,
      "statements": 45
    }
  },
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/src/$1"
  }
}
